<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_pdf_quote_import_tree" model="ir.ui.view">
        <field name="name">pdf.quote.import.tree</field>
        <field name="model">pdf.quote.import</field>
        <field name="arch" type="xml">
            <list string="PDF Quote Imports">
                <field name="name"/>
                <field name="filename"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pdf_quote_import_form" model="ir.ui.view">
        <field name="name">pdf.quote.import.form</field>
        <field name="model">pdf.quote.import</field>
        <field name="arch" type="xml">
            <form string="PDF Quote Import">
                <header>
                    <button name="action_import" string="Import PDF" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="filename"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="pdf_file" filename="filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Extracted Text" invisible="not extracted_text">
                            <field name="extracted_text"/>
                        </page>
                        <page string="Errors" invisible="state != 'failed'">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_pdf_quote_import_search" model="ir.ui.view">
        <field name="name">pdf.quote.import.search</field>
        <field name="model">pdf.quote.import</field>
        <field name="arch" type="xml">
            <search string="PDF Quote Imports">
                <field name="name"/>
                <field name="filename"/>
                <field name="partner_id"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Imported" name="imported" domain="[('state', '=', 'imported')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pdf_quote_import" model="ir.actions.act_window">
        <field name="name">PDF Quote Imports</field>
        <field name="res_model">pdf.quote.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first PDF quote import
            </p>
            <p>
                Import quotes from PDF files and create sale orders automatically.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_pdf_quote_import_root" 
              name="PDF Quote Import" 
              parent="sale.sale_menu_root" 
              sequence="10"/>
    
    <menuitem id="menu_pdf_quote_import" 
              name="PDF Imports" 
              parent="menu_pdf_quote_import_root" 
              action="action_pdf_quote_import" 
              sequence="1"/>
    
    <menuitem id="menu_pdf_import_wizard" 
              name="Import PDF Quote" 
              parent="menu_pdf_quote_import_root" 
              action="action_pdf_import_wizard" 
              sequence="2"/>

    <!-- Sequence -->
    <record id="seq_pdf_quote_import" model="ir.sequence">
        <field name="name">PDF Quote Import</field>
        <field name="code">pdf.quote.import</field>
        <field name="prefix">PDF-</field>
        <field name="padding">5</field>
    </record>
</odoo>
