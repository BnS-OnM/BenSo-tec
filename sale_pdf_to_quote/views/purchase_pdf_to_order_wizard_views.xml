<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase PDF to Order Wizard Form View -->
    <record id="view_purchase_pdf_to_order_wizard_form" model="ir.ui.view">
        <field name="name">purchase.pdf.to.order.wizard.form</field>
        <field name="model">purchase.pdf.to.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Import PDF to Purchase Order">
                <group>
                    <group>
                        <field name="state" invisible="1"/>
                        <field name="pdf_file" filename="filename" widget="binary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <field name="filename" invisible="1"/>
                        <field name="partner_id" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <field name="use_pdf_prices" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <field name="name_prefix" attrs="{'invisible': [('state', '=', 'done')]}"/>
                    </group>
                    <group>
                        <field name="restrict_to_brand" attrs="{'invisible': [('state', '=', 'done')]}"/>
                        <field name="brand_filter" attrs="{'invisible': ['|', ('state', '=', 'done'), ('restrict_to_brand', '=', False)]}"/>
                    </group>
                </group>

                <group attrs="{'invisible': [('state', '!=', 'done')]}">
                    <group>
                        <field name="purchase_order_id"/>
                        <field name="matched_count"/>
                        <field name="unmatched_count"/>
                    </group>
                </group>

                <notebook attrs="{'invisible': [('state', '!=', 'done')]}">
                    <page string="Unmatched Items" attrs="{'invisible': [('unmatched_count', '=', 0)]}">
                        <field name="unmatched_text" readonly="1" nolabel="1"/>
                    </page>
                </notebook>

                <footer>
                    <button string="Create Purchase Order" name="action_create_purchase_order" type="object" class="btn-primary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_purchase_pdf_to_order_wizard" model="ir.actions.act_window">
        <field name="name">Import PDF to Purchase Order</field>
        <field name="res_model">purchase.pdf.to.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_purchase_pdf_import"
              name="Import PDF to Purchase Order"
              parent="purchase.menu_purchase_root"
              action="action_purchase_pdf_to_order_wizard"
              sequence="99"/>

</odoo>
