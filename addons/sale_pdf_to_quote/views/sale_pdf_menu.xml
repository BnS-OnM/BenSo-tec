    <menuitem id="menu_pdf_to_quote"
              name="Import PDF to Quotation"
              parent="sale.sale_order_menu"
              action="action_pdf_to_quote_wizard"
              groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
              sequence="10"/>
</odoo>
