<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pdf_to_quote_wizard" model="ir.actions.act_window">
        <field name="name">Import PDF to Quotation</field>
        <field name="res_model">sale.pdf.to.quote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
